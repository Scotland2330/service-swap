# Postgres connection string. Use a hosted provider like Neon (https://neon.tech).
# For serverless (Vercel), use Neon's POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign session cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
